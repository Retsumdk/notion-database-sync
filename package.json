{
  "name": "notion-database-sync",
  "version": "1.0.0",
  "description": "Synchronize Notion databases with external data sources (CSV, JSON, Google Sheets)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "notion-sync": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublish": "npm run build",
    "prepare": "tsc"
  },
  "keywords": [
    "notion",
    "sync",
    "csv",
    "json",
    "database"
  ],
  "author": "Retsumdk",
  "license": "MIT",
  "dependencies": {
    "@notionhq/client": "^2.2.14",
    "csv-parse": "^5.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.14"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true
          }
        }
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
